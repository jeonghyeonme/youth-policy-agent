# 복사해서 .env로 저장한 뒤 값을 채우세요: cp .env.example .env
# .env는 커밋되지 않습니다. 키는 저장소 밖으로 공유하세요.

# 온통청년 청년정책 API (온통청년 마이페이지에서 발급)
YOUTHCENTER_API_KEY=

# 공공데이터포털 인증키 (잡알리오, LH, 복지로 각 서비스에 활용신청 필요)
DATA_GO_KR_SERVICE_KEY=

# LLM API 키 (업체 미정)
LLM_API_KEY=

# Groq API 키 (console.groq.com/keys에서 발급). 청년 정책 브랜치에서 무료 LLM 주 업체 후보로 시험함. 법률 토큰 측정(experiments/legal-tokens)에 사용
GROQ_API_KEY=

# 국가법령정보 공동활용 API 인증값 OC (open.law.go.kr 공동활용 신청 후 받는 사용자 ID). 법률 토큰 측정에 사용
LAW_API_OC=
