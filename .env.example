# 복사해서 .env로 저장한 뒤 값을 채우세요: cp .env.example .env
# .env는 커밋되지 않습니다. 키는 저장소 밖으로 공유하세요.

# 온통청년 청년정책 API (온통청년 마이페이지에서 발급)
YOUTHCENTER_API_KEY=

# 공공데이터포털 인증키 (잡알리오, LH, 복지로 각 서비스에 활용신청 필요)
DATA_GO_KR_SERVICE_KEY=

# Groq API 키 (console.groq.com/keys에서 발급, Q5 주 업체 후보)
GROQ_API_KEY=

# Mistral API 키 (console.mistral.ai, Q5 예비 후보)
MISTRAL_API_KEY=
